  "verification": {
    "conclusion": "All framed packet IDs and canonical packet kinds equal protocol 5; payload compatibility is not identical.",
    "framedPacketCounts": {
      "handshake": 1,
      "status": 4,
      "login": 5,
      "playClientbound": 65,
      "playServerbound": 24
    },
    "specialCases": [
      "0xFE legacy ping is accepted outside the normal VarInt-framed state registry and must not use the regular packet codec."
    ],
    "wireDeltasToProtocol5": [
      {
        "scope": "all string-encoded UUIDs",
        "protocol4": "32 lowercase/uppercase hex digits without hyphens",
        "protocol5": "canonical 36-character UUID with hyphens",
        "affected": [
          "login/clientbound success uuid",
          "play/clientbound named_entity_spawn playerUUID",
          "status response players.sample[].id when present"
        ]
      },
      {
        "scope": "play/clientbound named_entity_spawn (0x0c)",
        "protocol4Fields": [
          "entityId:varint",
          "playerUUID:string (dashless)",
          "playerName:string",
          "x:i32",
          "y:i32",
          "z:i32",
          "yaw:i8",
          "pitch:i8",
          "currentItem:i16",
          "metadata:entityMetadata"
        ],
        "protocol5InsertionAfterPlayerName": [
          "dataCount:varint",
          "data[dataCount]: {name:string,value:string,signature:string}"
        ]
      }
    ],
    "loginToPlay": {
      "loginSuccess": {
        "state": "login",
        "direction": "clientbound",
        "id": 2,
        "fields": [
          "uuid:string (dashless)",
          "username:string"
        ]
      },
      "firstVanillaPlayPacket": {
        "state": "play",
        "direction": "clientbound",
        "id": 1,
        "kind": "login",
        "commonName": "Join Game"
      },
      "evidence": "In 1.7.2 nd.c() sends jg (Login Success), then ld.a() first sends gu (Join Game). ef.b() resolves the outgoing packet class to ek.b (Play), switches the channel registry before write, then emits it."
    }
  },
