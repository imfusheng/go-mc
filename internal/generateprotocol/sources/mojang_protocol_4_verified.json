  "extraction": {
    "method": "Open the official server.jar as ZIP. Locate the enum class containing the UTF-8 constants Serverbound packet ID and Clientbound packet ID. Parse each state subclass constructor and collect integer literal + ldc packet class + invokevirtual registration method. Base enum error strings establish a=serverbound and b=clientbound. Map enum state constructor values -1/0/1/2 to Handshake/Play/Status/Login using handshake handler transitions. Join obfuscated packet classes to canonical kinds only after independent fixed-commit corroboration.",
    "tools": [
      {
        "name": "CFR",
        "version": "0.152",
        "url": "https://repo1.maven.org/maven2/org/benf/cfr/0.152/cfr-0.152.jar",
        "sha256": "f686e8f3ded377d7bc87d216a90e9e9512df4156e75b06c655a16648ae8765b2"
      },
      {
        "name": "jawa",
        "purpose": "Direct JVM classfile instruction extraction; decompiler output is review aid only."
      }
    ]
  },
